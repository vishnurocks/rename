# Set the target folder where the files are located
$folderPath = "C:\path\to\your\folder"

# Set the prefix to be removed
$prefixToRemove = "FSPALLS_QWERTY_123456"

# Get all the files in the target folder
Get-ChildItem -Path $folderPath | ForEach-Object {
    # Check if the file name contains the prefix
    if ($_.Name -like "*$prefixToRemove*") {
        # Remove the prefix from the file name
        $newName = $_.Name -replace [regex]::Escape($prefixToRemove), ""
        
        # Create the new file path with the updated name
        $newFilePath = Join-Path $folderPath $newName
        
        # Rename the file
        Rename-Item -Path $_.FullName -NewName $newFilePath
    }
}
